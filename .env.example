# =============================================================================
# REMY'S RECIPE SHARING APP - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV="development"  # Options: development | production | test

# Public URL of your application (used for SEO, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# For local development with Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recipe_sharing_db?schema=public"

# For production inside Docker network:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/recipe_sharing_db?schema=public"

# For production with external database (e.g., Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require"

# Connection pooling (recommended for production)
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=20

# -----------------------------------------------------------------------------
# AUTHENTICATION - JWT
# -----------------------------------------------------------------------------
# IMPORTANT: Generate strong secrets for production!
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"  # Options: 1h, 7d, 30d, etc.

# -----------------------------------------------------------------------------
# AUTHENTICATION - NEXTAUTH
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-this-in-production-min-32-chars"

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of email addresses that should be auto-promoted to admin
# Users with these emails will automatically have admin privileges on login
ADMIN_EMAILS="admin@yourdomain.com,owner@yourdomain.com"

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - for password reset, notifications)
# -----------------------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-specific-password"
# SMTP_FROM="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# FILE UPLOADS - CLOUDINARY (REQUIRED for production)
# -----------------------------------------------------------------------------
# Cloudinary configuration for image uploads (avatars, recipe images)
# Sign up at https://cloudinary.com to get your credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# FILE UPLOADS - LEGACY (Optional - for migration from local storage)
# -----------------------------------------------------------------------------
# AWS S3 / DigitalOcean Spaces / Cloudflare R2
# STORAGE_PROVIDER="s3"  # Options: local | s3
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"
# S3_BUCKET="recipe-images"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://nyc3.digitaloceanspaces.com"  # If not AWS

# -----------------------------------------------------------------------------
# MONITORING & LOGGING (Optional - Recommended for production)
# -----------------------------------------------------------------------------
# Sentry for error tracking
# NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# LogRocket for session replay
# NEXT_PUBLIC_LOGROCKET_ID="your-logrocket-id"

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID="G-XXXXXXXXXX"

# Plausible Analytics (privacy-friendly alternative)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="yourdomain.com"

# -----------------------------------------------------------------------------
# CORS & SECURITY
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Rate limiting
# RATE_LIMIT_MAX_REQUESTS="100"  # Max requests per window
# RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes in milliseconds

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
# NEXT_PUBLIC_ENABLE_SOCIAL_SHARING="true"
# NEXT_PUBLIC_ENABLE_COMMENTS="true"

# -----------------------------------------------------------------------------
# PRODUCTION CHECKLIST
# -----------------------------------------------------------------------------
# Before deploying to production, ensure:
# ✅ All secrets are strong, random, and at least 32 characters
# ✅ NODE_ENV is set to "production"
# ✅ NEXT_PUBLIC_APP_URL is your production domain
# ✅ DATABASE_URL points to production database with SSL
# ✅ JWT_SECRET and NEXTAUTH_SECRET are unique and secure
# ✅ ALLOWED_ORIGINS includes your production domain
# ✅ Error tracking (Sentry) is configured
# ✅ Database backups are configured
# ✅ Rate limiting is enabled
# =============================================================================
